# Application
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Persistent storage
DATA_DIR=/app/data
DATABASE_URL=sqlite+aiosqlite:////app/data/publisher.db

# API authentication — replace with a long random value
API_KEY=replace-with-a-long-random-secret

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL_SECONDS=15

# Retry and recovery
MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=30
RETRY_MAX_DELAY_SECONDS=3600
STALE_PUBLISHING_TIMEOUT_SECONDS=900

# Telegram credentials
# Prefer a mounted secret in production. This variable is a placeholder
# for local development only; never commit a real token.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
