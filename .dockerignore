# Keep the build context minimal; the image needs only pyproject.toml,
# README.md (package metadata), src/, alembic/, alembic.ini, docker/.

# VCS and tooling
.git/
.gitignore
.pytest_cache/
.ruff_cache/

# Environments and secrets — never enter the build context
.env
.venv/
venv/

# Local runtime data (SQLite databases, persistent app data)
data/
*.db
*.sqlite3

# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Not needed inside the image
tests/
docs/
docker-compose.yml
AGENTS.md
